apiVersion: apps/v1
kind: Deployment
metadata:
  name: llama-server
  namespace: llama
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels: {app: llama-server}
  template:
    metadata:
      labels: {app: llama-server}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile: {type: RuntimeDefault}
{% if llama_gpu %}
      runtimeClassName: nvidia
{% endif %}
      containers:
        - name: llama-server
          image: {{ llama_image | to_json }}
          imagePullPolicy: IfNotPresent
          args: ["-m", "/models/{{ llama_model_name }}", "--host", "0.0.0.0", "--port", "8081", "-c", "{{ llama_context }}", "--threads", "{{ llama_threads }}", "-ngl", "{{ 99 if llama_gpu else 0 }}"]
          ports: [{containerPort: 8081, name: http}]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          startupProbe:
            httpGet: {path: /health, port: http}
            failureThreshold: 60
            periodSeconds: 5
          readinessProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 10
          livenessProbe:
            tcpSocket: {port: http}
            periodSeconds: 20
          resources:
            requests:
              memory: {{ llama_memory | to_json }}
              cpu: {{ llama_cpus | string | to_json }}
{% if llama_gpu %}
              nvidia.com/gpu: 1
{% endif %}
            limits:
              memory: {{ llama_memory | to_json }}
              cpu: {{ llama_cpus | string | to_json }}
{% if llama_gpu %}
              nvidia.com/gpu: 1
{% endif %}
          volumeMounts:
            - {name: models, mountPath: /models, readOnly: true}
            - {name: temporary, mountPath: /tmp}
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: {{ llama_pvc | to_json }}
        - name: temporary
          emptyDir: {sizeLimit: 256Mi}
